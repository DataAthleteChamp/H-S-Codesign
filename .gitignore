# User images (private, large)
data/

# Generated outputs - keep model artifacts, ignore caches and large arrays
python/gen/cache/
python/gen/tuner/
python/gen/__pycache__/
python/gen/*.npy
python/gen/x_*.npy
python/gen/y_*.npy
python/gen/baseline_smoke_*
python/gen/model.c
python/gen/model.keras

# Bench results - keep markdown/csv/json/png reports, ignore large arrays
bench/results/*.npy

# Python
__pycache__/
*.pyc
*.egg-info/
venv/
.venv/
env/

# MediaPipe model binary (download via script or from Google)
python/*.tflite

# OS
.DS_Store

# IDE
.idea/
.vscode/

# ESP-IDF build artifacts
esp32/build/
esp32/managed_components/
esp32/sdkconfig
esp32/dependencies.lock
